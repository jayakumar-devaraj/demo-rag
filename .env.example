# Local Postgres for docker-compose.yml; placeholder values, set your own in .env
POSTGRES_USER=rag
POSTGRES_PASSWORD=<choose-a-local-password>
POSTGRES_DB=rag
POSTGRES_PORT=5434
DATABASE_URL=postgresql://rag:<choose-a-local-password>@localhost:5434/rag
TENANT_TOKENS=<token-a>:tenant-a,<token-b>:tenant-b
