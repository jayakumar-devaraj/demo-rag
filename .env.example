# Local Postgres for docker-compose.yml; placeholder values, set your own in .env
POSTGRES_USER=rag
POSTGRES_PASSWORD=<choose-a-local-password>
POSTGRES_DB=rag
POSTGRES_PORT=5434
DATABASE_URL=postgresql://rag:<choose-a-local-password>@localhost:5434/rag
# The API connects as this non-owner role (created by deploy/db/001_app_role.sh); migrations run as the owner above
APP_DB_USER=rag_app
APP_DB_PASSWORD=<choose-another-local-password>
MIGRATION_DATABASE_URL=postgresql://rag:<choose-a-local-password>@localhost:5434/rag
TENANT_TOKENS=<token-a>:tenant-a,<token-b>:tenant-b
# Optional model provider: all three required, otherwise /ingest and /chat return 503
OPENAI_API_KEY=<your-key>
OPENAI_CHAT_MODEL=<chat-model-id>
OPENAI_EMBEDDING_MODEL=<embedding-model-id-supporting-384-dimensions>
# Optional tracing
LANGFUSE_PUBLIC_KEY=<pk>
LANGFUSE_SECRET_KEY=<sk>
LANGFUSE_HOST=<langfuse-url>
# Primary chat provider (fallback: OPENAI_* above)
GROQ_API_KEY=<your-key>
GROQ_CHAT_MODEL=<groq-model-id>
# Local embeddings (must produce 384 dimensions)
FASTEMBED_MODEL=<fastembed-model-id>
# Provider-client retries for POST /v1/retrieve only (callers own retries); /chat always uses 2
RETRIEVE_LLM_MAX_RETRIES=0
# Optional OIDC tenant authentication (ADR 0002): set all three to accept signed JWTs
OIDC_ISSUERS=<issuer-url-1>,<issuer-url-2>
OIDC_AUDIENCE=<audience-this-api-expects>
OIDC_JWKS_URL=<jwks-url-of-the-identity-provider>
# Defaults: OIDC_ALGORITHMS=RS256,ES256 (asymmetric only), OIDC_TENANT_CLAIM=tenant, OIDC_CLOCK_SKEW_S=30
# Static TENANT_TOKENS keep working until this is false (migration switch)
ALLOW_STATIC_TOKENS=true
